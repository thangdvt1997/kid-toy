# Copy to `apps/api/.env.test` (gitignored). Loaded by
# apps/api/test/setup-env.ts before any e2e test module runs.
#
# CRITICAL: DATABASE_URL must target the dedicated `kidtoy_test` database —
# apps/api/test/utils/test-app.ts refuses to boot against anything else,
# since every e2e run TRUNCATEs every table before seeding.

# --- PostgreSQL (isolated test database — never the dev/prod one) ---
DATABASE_URL=postgresql://kidtoy:change-me-locally@localhost:5432/kidtoy_test?schema=public

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET_MEDIA=kidtoy-media
MINIO_BUCKET_DOCUMENTS=kidtoy-documents

# --- Auth / JWT ---
JWT_ACCESS_SECRET=generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=generate-with-a-different-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_RESET_TTL_MINUTES=60
BCRYPT_COST=12

# Password hashed once and reused for every seeded account (prisma/seed.ts
# throws if this is unset — never hardcode a password literal in seed.ts)
SEED_DEFAULT_PASSWORD=change-me-locally-min-8

# --- API / App ---
API_PORT=4001
API_CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Raise the /auth/* throttle far above production's 5/min default — an e2e
# suite makes many sequential login/register calls from one client and would
# otherwise trip the same rate limiting real credential-stuffing defenses.
AUTH_THROTTLE_LIMIT=1000

# Same reasoning as AUTH_THROTTLE_LIMIT, for POST /api/business-accounts/register.
BUSINESS_REGISTER_THROTTLE_LIMIT=1000

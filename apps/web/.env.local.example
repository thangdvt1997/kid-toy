# Copy to .env.local for local development (gitignored, never commit real values).

# Used by the browser — must be reachable from the visitor's machine.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Used by Next.js server-side rendering — prefer this when the API is
# reachable via an internal/container hostname (e.g. http://api:4000) that
# differs from the public browser-facing origin above. Falls back to
# NEXT_PUBLIC_API_URL when unset.
API_INTERNAL_URL=http://localhost:4000

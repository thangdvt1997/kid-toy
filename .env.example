# Copy to `.env` and fill real values. `.env` is gitignored. Deployment credentials
# live ONLY in `.env.deploy` (also gitignored) — never in this file, never in
# docker-compose*.yml, never in a Dockerfile.

# --- PostgreSQL ---
POSTGRES_DB=kidtoy
POSTGRES_USER=kidtoy
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql://kidtoy:change-me-locally@localhost:5432/kidtoy?schema=public
SHADOW_DATABASE_URL=postgresql://kidtoy:change-me-locally@localhost:5432/kidtoy_shadow?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET_MEDIA=kidtoy-media
MINIO_BUCKET_DOCUMENTS=kidtoy-documents

# --- Auth / JWT ---
JWT_ACCESS_SECRET=generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=generate-with-a-different-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_RESET_TTL_MINUTES=60
BCRYPT_COST=12

# --- Uploads (business licence / product images) ---
UPLOAD_MAX_DOCUMENT_BYTES=10485760
UPLOAD_MAX_IMAGE_BYTES=5242880

# Password hashed once and reused for every seeded account (prisma/seed.ts
# throws if this is unset — never hardcode a password literal in seed.ts)
SEED_DEFAULT_PASSWORD=change-me-locally-min-8

# --- API / App ---
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
